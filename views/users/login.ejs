<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
    <div class="col-12 col-md-6 offset-md-3">
        <h2 class="mb-3 fw-bold">Log in to Wanderlust</h2>
        <form action="/login" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input name="username" id="username" type="text" class="form-control" required>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input name="password" id="password" type="password" class="form-control" required>
            </div>
            <button class="btn btn-dark add-btn w-100 py-2">Log in</button>
        </form>

        <!-- CHANGE: One-click Demo Login for recruiters testing CRUD & Reviews -->
        <div class="border-top mt-4 pt-3 text-center">
            <p class="text-secondary small mb-2">Want to explore without signing up?</p>
            <form action="/demo-login" method="POST">
                <button type="submit" class="btn btn-outline-dark w-100 py-2">
                    <i class="fa-solid fa-bolt me-2"></i>Continue with Demo Account
                </button>
            </form>
            <p class="text-secondary small mt-3 mb-0">
                New here? <a href="/signup" class="text-dark fw-semibold">Create an account</a>
            </p>
        </div>
    </div>
</div>