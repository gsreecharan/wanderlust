<% layout("/layouts/boilerplate") %>
<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="row mt-3">
    <div class="col-12 col-md-8 offset-md-2">
        <h3 class="fw-bold mb-3"><%= listing.title %></h3>
    </div>

    <div class="card col-12 col-md-8 offset-md-2 show-card listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="<%= listing.title %>">
        <div class="card-body mt-3">
            <!-- CHANGE: Null-safe owner username (prevents crash if seeded owner ID is missing) -->
            <p class="card-text text-secondary mb-2">
                Hosted by <i>@<%= listing.owner ? listing.owner.username : "wanderlust_host" %></i>
            </p>
            <p class="card-text mb-2"><%= listing.description %></p>
            <p class="card-text fw-bold fs-5 mb-1">
                &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "Not Available" %>
                <span class="fw-normal fs-6 text-secondary">/ night</span>
            </p>
            <p class="card-text text-secondary">
                <i class="fa-solid fa-location-dot me-1"></i>
                <%= listing.location %>, <%= listing.country %>
            </p>
        </div>
    </div>
</div>

<!-- CHANGE: Null-safe listing.owner check before calling .equals() -->
<% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)){ %>
<div class="row">
    <div class="btns d-flex align-items-center mb-3 col-12 col-md-8 offset-md-2">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn me-3 px-4">Edit</a>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="m-0">
            <button class="btn btn-outline-dark px-4">Delete</button>
        </form>
    </div>
</div>
<% } %>

<hr class="col-12 col-md-8 offset-md-2">

<div class="row">
    <div class="col-12 col-md-8 offset-md-2 mb-3">
        <% if(currUser) { %>
        <h4 class="mb-3 mt-3">Leave a Review</h4>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
                <label for="rating" class="form-label">Rating</label>
                <fieldset class="starability-basic">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
            </div>

            <div class="mb-3 mt-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control" required></textarea>
                <div class="invalid-feedback">
                    Please add some comments for your review.
                </div>
            </div>

            <button class="btn btn-outline-dark">Submit</button>
        </form>
        <% } else { %>
        <!-- CHANGE: Prompt logged-out visitors/recruiters to log in and test reviews -->
        <div class="alert alert-light border d-flex justify-content-between align-items-center mt-3">
            <span class="small text-secondary">Want to leave a review or host a stay?</span>
            <a href="/login" class="btn btn-sm btn-dark rounded-pill px-3">Log in / Demo</a>
        </div>
        <% } %>

        <% if(listing.reviews.length > 0) { %>
        <hr/>
        <p class="fw-bold fs-5">All Reviews (<%= listing.reviews.length %>)</p>
        <div class="row">
            <% for(let review of listing.reviews) { %>
                <div class="col-12 col-md-6 mb-3">
                    <div class="card p-3 shadow-sm border rounded-3 h-100">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <h6 class="card-title fw-bold">@<%= review.author ? review.author.username : "wanderer" %></h6>
                                <p class="starability-result card-text mb-2" data-rating="<%= review.rating %>"></p>
                                <p class="card-text text-secondary mb-3"><%= review.comment %></p>
                            </div>

                            <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
                            <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="m-0">
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</button>
                            </form>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
        <% } %>
    </div>

    <div class="col-12 col-md-8 offset-md-2 mb-4">
        <h4 class="fw-bold mb-3">Where you'll be</h4>
        <div id="map"></div>
    </div>
</div>

<script src="/js/map.js"></script>