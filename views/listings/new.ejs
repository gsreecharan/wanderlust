<% layout("/layouts/boilerplate") %>
<div class="row mt-4">
    <div class="col-12 col-md-8 offset-md-2">
        <h3 class="mb-3">Create a New Listing</h3>
        <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input name="listing[title]" placeholder="Add a catchy title" type="text" class="form-control" required>
                <div class="valid-feedback">Title looks good!</div>
                <div class="invalid-feedback">Please enter a title.</div>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="listing[description]" rows="3" class="form-control" required></textarea>
                <div class="invalid-feedback">Please enter a short description.</div>
            </div>

            <div class="mb-3">
                <!-- CHANGE: Fixed spelling "Listining" -> "Listing" and added accept filter -->
                <label for="image" class="form-label">Upload Listing Image</label>
                <input name="listing[image]" type="file" accept="image/png, image/jpeg, image/webp" class="form-control" required>
                <div class="invalid-feedback">Please upload an image (PNG, JPG, or WEBP).</div>
            </div>

            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price (&#8377; / night)</label>
                    <!-- CHANGE: Added type="number" min="0" -->
                    <input name="listing[price]" placeholder="4500" type="number" min="0" class="form-control" required>
                    <div class="invalid-feedback">Please enter a valid price.</div>
                </div>

                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input name="listing[country]" placeholder="India" type="text" class="form-control" required>
                    <!-- CHANGE: Fixed validation message from "location" -> "country" -->
                    <div class="invalid-feedback">Please enter a valid country.</div>
                </div>
            </div>

            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input name="listing[location]" placeholder="Hyderabad, Telangana" type="text" class="form-control" required>
                <!-- CHANGE: Fixed validation message from "number" -> "location" -->
                <div class="invalid-feedback">Please enter a valid location.</div>
            </div>

            <button class="btn btn-dark add-btn mt-2 mb-4 px-4">Add Listing</button>
        </form>
    </div>
</div>